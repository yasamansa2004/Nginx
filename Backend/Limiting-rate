Scenario:
Max 5 requests per second per IP
Burst of 10
Delay of 6
HTTP status 429
Dry run enabled for testing


http {

    limit_req_zone $binary_remote_addr zone=limitbyaddr:10m rate=5r/s;
    limit_req_status 429;
    limit_req_log_level warn;

    log_format rate_log
        '$remote_addr '
        'status=$status '
        'rate=$limit_req_status';

    access_log /var/log/nginx/access.log rate_log;

    server {
        listen 80;
        server_name example.com;

        location /api/ {
            limit_req zone=limitbyaddr burst=10 delay=6;
            limit_req_dry_run on;

            proxy_pass http://backend_api;
        }
    }
}
